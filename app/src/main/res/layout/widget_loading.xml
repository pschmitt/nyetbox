<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews placeholder shown before Glance's own composition replaces it - required by
     appwidget-provider's initialLayout/previewLayout, which can't reference a Compose layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ic_launcher_background"
    tools:ignore="Overdraw">
    <!-- This is a widget host RemoteViews layout, not an Activity content view - lint's Overdraw
         detector documents that it infers the "owning" theme via inexact source-code pattern
         matching, which doesn't apply here since nothing hosts this behind Theme.Nyetbox. -->

    <ProgressBar
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center" />

</FrameLayout>
